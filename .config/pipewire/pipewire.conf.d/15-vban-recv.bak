context.modules = [
  {
    name = libpipewire-module-vban-recv
    args = {
      # deixe IGUAL ao que já funciona pra B1/B2/B3
      # source.port = 6980

      sess.latency.msec = 20
      stream.rules = [

        # ---- Mics (Windows -> Arch) ----
        {
          matches = [{ sess.name = "WIN_MIC" }]
          actions = {
            create-stream = {
              stream.props = {
                node.name = "vban-win-mic"
                node.description = "VBAN Windows Mic"
                media.class = "Audio/Source"
                audio.position = [ FL FR ]
              }
            }
          }
        }
        {
          matches = [{ sess.name = "WIN_GAMES" }]
          actions = {
            create-stream = {
              stream.props = {
                node.name = "vban-win-games"
                node.description = "VBAN Windows Games"
                media.class = "Audio/Source"
                audio.position = [ FL FR ]
              }
            }
          }
        }
        {
          matches = [{ sess.name = "WIN_AUX" }]
          actions = {
            create-stream = {
              stream.props = {
                node.name = "vban-win-aux"
                node.description = "VBAN Windows Aux"
                media.class = "Audio/Source"
                audio.position = [ FL FR ]
              }
            }
          }
        }
      ]
    }
  }
]
