font-family = JetBrainsMono Nerd Font
font-size = 11.0

theme = catppuccin-mocha
background-opacity = 0.8
window-decoration = false

# Shift + Backspace: enviar sequência exclusiva ao Zsh
keybind = shift+backspace=text:\x15

# ─── Splits ────────────────────────────────────────

# Abrir splits
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down

# Fechar somente o split selecionado
keybind = ctrl+shift+w=close_surface

# Navegar entre splits
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down

# Maximizar/restaurar temporariamente um split
# keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+enter=unbind
keybind = ctrl+shift+enter=unbind

# Igualar o tamanho dos splits
keybind = ctrl+shift+equal=equalize_splits

keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=last_tab

keybind = ctrl+g>key_c=write_scrollback_file:paste,plain
keybind = f8=write_scrollback_file:paste,plain
