#!/usr/bin/env bash

set -u

TARGET="${1:-}"
ACTION="${2:-focus}"

LAYOUT="$HOME/.config/bspwm/atno/layout.sh"

# Só reconstrói o layout se a divisão não estiver pronta.
split_ready() {
    xrandr --listmonitors | awk '
        /^[[:space:]]*[0-9]+:/ {
            n++
            name=$2
            gsub(/[+*]/, "", name)

            if (name=="TOP" &&
                $3 ~ /^1080\/[0-9]+x960\/[0-9]+\+0\+0$/ &&
                $4=="HDMI-A-0") t=1

            if (name=="BOTTOM" &&
                $3 ~ /^1080\/[0-9]+x960\/[0-9]+\+0\+960$/) b=1
        }
        END {exit !(n==2 && t && b)}
    ' || return 1

    local monitor expected

    for monitor in TOP BOTTOM; do
        case "$monitor" in
            TOP) expected="0,0,1080,960" ;;
            BOTTOM) expected="0,960,1080,960" ;;
        esac

        bspc query -T -m "$monitor" |
            python3 -c '
import json
import sys

r = json.load(sys.stdin)["rectangle"]
actual = ",".join(str(r[k]) for k in
                  ("x", "y", "width", "height"))
sys.exit(0 if actual == sys.argv[1] else 1)
' "$expected" || return 1
    done

    bspc query -D -m BOTTOM --names |
        grep -Fxq B1 || return 1

    return 0
}


current_monitor() {
    bspc query -M -m focused --names 2>/dev/null || echo TOP
}

is_full_workspace() {
    case "$1" in
        7|8|9) return 0 ;;
        *) return 1 ;;
    esac
}

case "$TARGET" in
    1|2|3|4|5|6)
        SOURCE_MONITOR="$(current_monitor)"

        if ! split_ready; then
            "$LAYOUT" split || exit 1
        fi

        TOP_DESKTOP="T$TARGET"
        BOTTOM_DESKTOP="B$TARGET"

        case "$ACTION" in
            focus)
                # Troca as duas metades para o mesmo workspace lógico.
                bspc desktop "$TOP_DESKTOP" -f
                bspc desktop "$BOTTOM_DESKTOP" -f

                # Recupera o foco para o lado onde o usuário estava.
                case "$SOURCE_MONITOR" in
                    BOTTOM)
                        bspc monitor BOTTOM -f
                        ;;
                    *)
                        bspc monitor TOP -f
                        ;;
                esac
                ;;

            move)
                case "$SOURCE_MONITOR" in
                    BOTTOM)
                        bspc node -d "$BOTTOM_DESKTOP"
                        ;;
                    *)
                        bspc node -d "$TOP_DESKTOP"
                        ;;
                esac
                ;;

            move-follow)
                case "$SOURCE_MONITOR" in
                    BOTTOM)
                        bspc node -d "$BOTTOM_DESKTOP" --follow
                        ;;
                    *)
                        bspc node -d "$TOP_DESKTOP" --follow
                        ;;
                esac
                ;;

            *)
                exit 1
                ;;
        esac
        ;;

    7|8|9)
        "$LAYOUT" full

        case "$ACTION" in
            focus)
                bspc monitor TOP -f
                bspc desktop "$TARGET" -f
                ;;

            move)
                bspc node -d "$TARGET"
                ;;

            move-follow)
                bspc node -d "$TARGET" --follow
                ;;

            *)
                exit 1
                ;;
        esac
        ;;

    *)
        exit 1
        ;;
esac
