#!/usr/bin/env bash
# Layout vertical 1080x1920: SPLIT (TOP/BOTTOM) ou FULL (TOP inteiro).
# O monitor BSPWM TOP e o proprio HDMI fisico renomeado. Isso evita que
# o BSPWM mantenha um HDMI-A-0 extra sobre as duas metades.
set -uo pipefail

PRIMARY="HDMI-A-0"

has_monitor() {
    bspc query -M --names 2>/dev/null | grep -Fxq "$1"
}

has_desktop() {
    bspc query -D --names 2>/dev/null | grep -Fxq "$1"
}

ensure_monitor() {
    local name="$1" rect="$2"
    if has_monitor "$name"; then
        bspc monitor "$name" --rectangle "$rect"
    else
        bspc wm --add-monitor "$name" "$rect"
    fi
}

ensure_desktop() {
    local name="$1" target="$2"
    if ! has_desktop "$name"; then
        bspc monitor "$target" -a "$name"
    fi
}

# BSPWM consulta as saidas fisicas do RandR. Um --setmonitor do xrandr
# NAO transforma HDMI-A-0 em duas saidas fisicas para o BSPWM.
# Por isso preservamos o ID fisico: HDMI-A-0 vira TOP no BSPWM.
# Se um TOP virtual antigo ja existir, seus desktops sao migrados antes.
adopt_primary_as_top() {
    has_monitor "$PRIMARY" || return 0

    if has_monitor TOP; then
        local keep="__atno_transfer_TOP__" d
        while has_desktop "$keep"; do keep="${keep}_"; done

        # bspc proibe transferir o ultimo desktop: criar um sentinela vazio.
        bspc monitor TOP -a "$keep" || return 1
        while read -r d; do
            [[ -n "$d" ]] || continue
            bspc desktop "$d" -m "$PRIMARY" || {
                echo "Falha ao migrar desktop $d; TOP original preservado." >&2
                return 1
            }
        done < <(bspc query -D -m TOP 2>/dev/null | grep -vFx "$(bspc query -D -d "$keep" 2>/dev/null)" )

        # Aqui, TOP antigo so tem o sentinela vazio.
        bspc monitor TOP -r || return 1
    fi

    bspc monitor "$PRIMARY" -n TOP
}

# Um desktop "Desktop" vazio e criado automaticamente pelo bspwm para
# monitores novos. Se estiver ocupado, -r MESCLA suas janelas no vizinho.
# Fazer isto somente apos criar T1/B1 impede perda de janelas.
cleanup_default_desktops() {
    local m d name count
    for m in TOP BOTTOM; do
        has_monitor "$m" || continue
        count="$(bspc query -D -m "$m" 2>/dev/null | wc -l)"
        (( count > 1 )) || continue
        while read -r d; do
            [[ -n "$d" ]] || continue
            name="$(bspc query -D -d "$d" --names 2>/dev/null)"
            if [[ "$name" == Desktop ]]; then
                bspc desktop "$d" -r || return 1
                break
            fi
        done < <(bspc query -D -m "$m" 2>/dev/null)
    done
}

setup_monitors() {
    case "$1" in
        split)
            ensure_monitor TOP "1080x960+0+0" || return 1
            ensure_monitor BOTTOM "1080x960+0+960" || return 1
            ;;
        full)
            ensure_monitor TOP "1080x1920+0+0" || return 1
            ensure_monitor BOTTOM "1x1+1079+1919" || return 1
            ;;
        *) return 1 ;;
    esac
    ensure_monitor PARK "1x1+1079+1919" || return 1
}

setup_desktops() {
    local n
    for n in 1 2 3 4 5 6; do
        ensure_desktop "T$n" TOP || return 1
        ensure_desktop "B$n" BOTTOM || return 1
    done
    for n in 7 8 9; do
        ensure_desktop "$n" TOP || return 1
    done
    # O bspwm nao permite mover o ultimo desktop de um monitor.
    # Estes dois desktops vazios mantem BOTTOM e PARK vivos ao alternar modos.
    ensure_desktop "__atno_bottom_keep__" BOTTOM || return 1
    ensure_desktop "__atno_park_keep__" PARK || return 1
}

# Evita mexer no RandR ao trocar entre T1/B1, T2/B2 etc.
# O xrandr exibe dimensoes fisicas em milimetros, que podem variar:
# conferimos apenas os pixels, a posicao e o nome logico.
randr_is_split() {
    xrandr --listmonitors 2>/dev/null | awk -v primary="$PRIMARY" '
        /^[[:space:]]*[0-9]+:/ {
            n++
            name=$2
            gsub(/[+*]/, "", name)
            if (name=="TOP" && $3 ~ /^1080\/[0-9]+x960\/[0-9]+\+0\+0$/ && $4==primary) t=1
            if (name=="BOTTOM" && $3 ~ /^1080\/[0-9]+x960\/[0-9]+\+0\+960$/) b=1
        }
        END {exit !(n==2 && t && b)}
    '
}

randr_is_full() {
    xrandr --listmonitors 2>/dev/null | awk -v primary="$PRIMARY" '
        /^[[:space:]]*[0-9]+:/ {
            n++
            name=$2
            gsub(/[+*]/, "", name)
            if (name=="TOP" && $3 ~ /^1080\/[0-9]+x1920\/[0-9]+\+0\+0$/ && $4==primary) t=1
        }
        END {exit !(n==1 && t)}
    '
}

setup_output() {
    xrandr --output "$PRIMARY" --mode 1920x1080 --rotate right --primary
}

clear_logical_monitors() {
    xrandr --delmonitor TOP 2>/dev/null || true
    xrandr --delmonitor BOTTOM 2>/dev/null || true
    xrandr --delmonitor FULL 2>/dev/null || true
}

randr_split() {
    randr_is_split && return 0
    setup_output || return 1
    clear_logical_monitors
    xrandr --setmonitor TOP 1080/527x960/148+0+0 "$PRIMARY" || return 1
    xrandr --setmonitor BOTTOM 1080/527x960/148+0+960 none || return 1
    sleep 0.2  # aguarda o BSPWM processar eventos RandR
}

randr_full() {
    randr_is_full && return 0
    setup_output || return 1
    clear_logical_monitors
    xrandr --setmonitor TOP 1080/527x1920/296+0+0 "$PRIMARY" || return 1
    sleep 0.2
}

# Os monitores PARK e BOTTOM se sobrepoem no modo FULL por design.
# Os dois monitores virtuais precisam sobreviver a eventos RandR.
configure_bspwm() {
    bspc config merge_overlapping_monitors false
    bspc config remove_unplugged_monitors false
}

split_mode() {
    configure_bspwm || return 1
    randr_split || return 1
    adopt_primary_as_top || return 1
    setup_monitors split || return 1
    setup_desktops || return 1
    cleanup_default_desktops || return 1

    local n
    for n in 1 2 3 4 5 6; do
        bspc desktop "B$n" -m BOTTOM 2>/dev/null || true
    done

    bspc monitor TOP --rectangle "1080x960+0+0" || return 1
    bspc monitor BOTTOM --rectangle "1080x960+0+960" || return 1
    bspc monitor PARK --rectangle "1x1+1079+1919" || return 1

    # Ordem estavel para os atalhos que usam indices (^1, ^2, ...).
    bspc wm -O TOP BOTTOM PARK || return 1

    bspc config -m TOP top_padding 32
    bspc config -m BOTTOM top_padding 0
    bspc config -m PARK top_padding 0
    bspc config focus_follows_pointer true
}

full_mode() {
    configure_bspwm || return 1
    randr_full || return 1
    adopt_primary_as_top || return 1
    setup_monitors full || return 1
    setup_desktops || return 1
    cleanup_default_desktops || return 1

    local n
    for n in 1 2 3 4 5 6; do
        bspc desktop "B$n" -m PARK 2>/dev/null || true
    done

    bspc monitor TOP --rectangle "1080x1920+0+0" || return 1
    bspc monitor BOTTOM --rectangle "1x1+1079+1919" || return 1
    bspc monitor PARK --rectangle "1x1+1079+1919" || return 1

    # Ordem estavel para os atalhos que usam indices (^1, ^2, ...).
    bspc wm -O TOP BOTTOM PARK || return 1

    bspc config -m TOP top_padding 32
    bspc config -m BOTTOM top_padding 0
    bspc config -m PARK top_padding 0
    bspc config focus_follows_pointer true
}

case "${1:-}" in
    split) split_mode ;;
    full)  full_mode ;;
    *) echo "Uso: $0 {split|full}" >&2; exit 1 ;;
esac
